{
  "expo": {
    "name": "CoachUp",
    "slug": "coachup",
    "version": "1.5.7",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/fav.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app.coachup.app"
    },
    "android": {
      "package": "com.app.coachup.app",
      "versionCode": 41,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBnbHJfEa1GLOSKiVxxix-lrNPgn7di938"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/fav.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CoachUp antrenman rotanızı ve mesafenizi takip etmek için konum izni gerektirir.",
          "locationAlwaysPermission": "CoachUp ekran kilitliyken veya arka plandayken antrenman rotanızı takip etmek için arka plan konum izni gerektirir.",
          "locationWhenInUsePermission": "CoachUp antrenman rotanızı ve mesafenizi takip etmek için konum izni gerektirir.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CoachUp QR kod tarama ve profil fotoğrafı için kamera izni gerektirir."
        }
      ],
      "expo-sharing"
    ]
  }
}
